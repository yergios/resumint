{
    "name": "resumint",
    "version": "1.0.0",
    "description": "Generate multilingual resumes from JSON data",
    "main": "./src/main.ts",
    "type": "module",
    "bin": {
        "resumint": "./dist/main.js"
    },
    "scripts": {
        "start": "node ./dist/main.js",
        "build": "tsc",
        "demo": "node ./dist/main.js --data ./workspace/content/example.yaml --html",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "style": "biome check --write ."
    },
    "keywords": [
        "resume",
        "cv",
        "generator",
        "pdf",
        "multilingual"
    ],
    "author": "Sergio Y. Lee",
    "license": "MIT",
    "packageManager": "pnpm@10.29.3",
    "dependencies": {
        "handlebars": "4.7.9",
        "nspell": "2.1.5",
        "puppeteer": "24.40.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.15",
        "@types/js-yaml": "4.0.9",
        "js-yaml": "4.1.1",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
