{
    "name": "resumint",
    "version": "1.0.0",
    "description": "CLI tool to generate PDF, multilingual resumes from YAML or JSON data using HTML templates styled with CSS.",
    "main": "./src/main.ts",
    "type": "module",
    "bin": {
        "resumint": "./dist/main.js"
    },
    "scripts": {
        "start": "node ./dist/main.js",
        "build": "tsc",
        "test": "tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\"",
        "demo": "node ./dist/main.js ./workspace/content/example.yaml",
        "lint": "biome lint --write .",
        "lint:check": "biome lint .",
        "format": "biome format --write .",
        "format:check": "biome format ."
    },
    "keywords": [
        "resume",
        "cv",
        "generator",
        "pdf",
        "multilingual"
    ],
    "author": "Sergio Y. Lee",
    "license": "MIT",
    "packageManager": "pnpm@10.29.3",
    "dependencies": {
        "nspell": "2.1.5",
        "puppeteer-core": "24.40.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.15",
        "@types/js-yaml": "4.0.9",
        "js-yaml": "4.1.1",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
